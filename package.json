{
  "name": "@callumbicknell/ssh-mcp",
  "version": "0.2.1",
  "description": "MCP server for interacting with remote machines over SSH using your existing OpenSSH configuration",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ssh-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CallumBicknell/ssh-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ssh",
    "sftp",
    "remote-administration"
  ],
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ssh-config": "^5.3.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ssh2": "^1.15.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "homepage": "https://github.com/CallumBicknell/ssh-mcp#readme"
}
